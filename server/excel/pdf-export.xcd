<?xml version="1.0" encoding="UTF-8"?>
<!-- Approved Excel-only standard searchable PDF output. Per-cell accessibility
     tags can exhaust the bounded parser on ordinary long tables. Visual content,
     values, geometry, macro policy and sandboxing remain unchanged. -->
<oor:data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Filter"><node oor:name="PDF"><node oor:name="Export">
      <prop oor:name="UseTaggedPDF" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
      <prop oor:name="PDFUACompliance" oor:op="fuse" oor:finalized="true"><value>false</value></prop>
    </node></node></node>
  </oor:component-data>
</oor:data>
