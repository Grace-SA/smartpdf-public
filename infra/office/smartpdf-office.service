[Unit]
Description=Smart PDF shared Word and PowerPoint conversion service
Requires=docker.service
After=docker.service network.target
Conflicts=smartpdf-word.service

[Service]
Type=simple
User=smartpdf
Group=smartpdf
SupplementaryGroups=docker
WorkingDirectory=/opt/smartpdf/current
EnvironmentFile=/etc/smartpdf-word.env
Environment=WORD_PORT=4268
Environment=WORD_DATA_DIR=/var/lib/smartpdf-word/tasks
Environment=PPT_PORT=4281
Environment=PPT_DATA_DIR=/var/lib/smartpdf-ppt/tasks
Environment=PPT_PUBLIC_ORIGIN=https://smartpdf.com.au
Environment=OFFICE_SHARED_MODE=true
ExecStartPre=/usr/bin/python3 server/word/doctor.py --production
ExecStartPre=/usr/bin/python3 server/ppt/doctor.py --production
# The legacy and combined processes cannot both hold this host lock.
ExecStart=/usr/bin/flock --no-fork --nonblock /var/lib/smartpdf-word/service.lock /usr/local/bin/node server/office/service.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
MemoryMax=768M
TasksMax=256
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smartpdf-word /var/lib/smartpdf-ppt

[Install]
WantedBy=multi-user.target
