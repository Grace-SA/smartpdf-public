[Unit]
Description=Smart PDF Word conversion service
Requires=docker.service
After=docker.service network.target

[Service]
Type=simple
User=smartpdf
Group=smartpdf
SupplementaryGroups=docker
WorkingDirectory=/opt/smartpdf/current
EnvironmentFile=/etc/smartpdf-word.env
Environment=WORD_PORT=4268
Environment=WORD_DATA_DIR=/var/lib/smartpdf-word/tasks
# Preflight never creates resources. The lock is outside the disposable task folder.
ExecStartPre=/usr/bin/python3 server/word/doctor.py --production
ExecStart=/usr/bin/flock --no-fork --nonblock /var/lib/smartpdf-word/service.lock /usr/local/bin/node server/word/service.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
MemoryMax=768M
TasksMax=256
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smartpdf-word

[Install]
WantedBy=multi-user.target
