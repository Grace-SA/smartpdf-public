[Unit]
Description=Smart PDF Word conversion service
Requires=docker.service
After=docker.service network.target

[Service]
Type=simple
User=smartpdf
Group=smartpdf
SupplementaryGroups=docker
WorkingDirectory=/opt/smartpdf
Environment=WORD_PORT=4268
Environment=WORD_DATA_DIR=/var/lib/smartpdf-word/tasks
# Set WORD_PUBLIC_ORIGIN and WORD_PROCESSING_LABEL in an operator-owned drop-in.
ExecStart=/usr/bin/node server/word/service.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/smartpdf-word

[Install]
WantedBy=multi-user.target
