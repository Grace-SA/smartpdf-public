# Start with reviewed product/build inputs; unrelated workspace projects stay out.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.githooks/
!/AGENTS.md
!/README.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.json
!/vite.config.ts
!/vitest.config.ts
!/eslint.config.js
!/.prettierignore
!/index.html
!/playwright*.config.ts
!/src/
!/tests/
!/scripts/
!/patches/
!/public/
!/vendor-fonts/
!/vendor-licenses/
!/vendor-sources/
!/infra/
!/config/
!/docs/

node_modules/
.git/
.aws/
.env
.env.*
!.env.example
*.local
*.log
*.pem
*.key
*.p12
*.pfx
*.trace
__pycache__/
*.pyc
dist/
dist-*/
releases/
test-results*/
playwright-report/
private-samples/
.local-python/
.git-bootstrap-check/
.git-tools/
/public/pdf-resources.json
/public/qpdf.wasm
/public/notices/

# Historical reports can contain personal file names and local paths.
/docs/*
!/docs/requirements-v1.1.md
!/docs/dependency-licenses.json
!/docs/repository-workflow.md
!/docs/m9-report.md
!/docs/ux/
/docs/ux/*
!/docs/ux/m9-page-numbers-design.md
!/docs/ux/public-synthetic-only/
/docs/ux/public-synthetic-only/manifest.json

# Private-corpus research scripts are intentionally local-only.
/scripts/*
!/scripts/prepare-assets.mjs
!/scripts/generate-module-map.mjs
!/scripts/generate-seo-pages.mjs
!/scripts/generate-fixtures.mts
!/scripts/extra-fixtures.py
!/scripts/generate-color-fixtures.py
!/scripts/generate-heic-fixtures.py
!/scripts/generate-combine-benchmark.mts
!/scripts/generate-public-ux-fixtures.mjs
!/scripts/m5-fixtures.py
!/scripts/m10-fixtures.py
!/scripts/prepare-watermark-font.py
!/scripts/prepare-number-font.py
!/scripts/verify-number-output.py
!/scripts/requirements-test.txt
!/scripts/run-local-tool.ps1
!/scripts/windows-realpath-compat.cjs
!/scripts/check-repository.mjs
!/scripts/test-repository-guard.mjs
!/scripts/prepare-release.mjs

/tests/review-color.spec.ts
/tests/ux-performance.spec.ts
/tests/ux5-performance.test.ts
/playwright.sign-private.config.ts
/tests/fixtures/m5/large-50mb.pdf
/tests/fixtures/m5/100mb.pdf

# Commit/push hooks check all binary files against reviewed hashes and provenance.
