import { makeFixture, cases, type FixtureKind } from "../tests/fixtures.ts";
import { mkdir, writeFile } from "node:fs/promises";
import { createHash } from "node:crypto";
await mkdir("tests/fixtures", { recursive: true });
const manifest = [];
for (const kind of [
  "plain",
  "geometry",
  "metadata",
  "token-text",
  ...Object.keys(cases),
] as FixtureKind[]) {
  const bytes = await makeFixture(kind);
  const path = `tests/fixtures/${kind}.pdf`;
  await writeFile(path, bytes);
  manifest.push({
    path,
    kind,
    origin:
      "Synthetic PDF objects generated by pdf-lib; not real user documents or valid certificate signatures",
    sha256: createHash("sha256").update(bytes).digest("hex"),
  });
}
await writeFile(
  "tests/fixtures/manifest.json",
  JSON.stringify(manifest, null, 2),
);
