{
  "name": "smartworks-pdf",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ppt:serve": "node server/ppt/service.mjs",
    "word:serve": "node server/word/service.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build && node scripts/generate-module-map.mjs && node scripts/generate-seo-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.mvp-final.config.ts",
    "test:regression": "vitest run tests/m5-regression.test.ts",
    "verify:feature": "pnpm typecheck && pnpm test && pnpm build && pnpm exec playwright test --config playwright.github.config.ts",
    "repo:check": "node scripts/check-repository.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "fast-xml-parser": "5.11.2",
    "libheif-js": "1.23.5",
    "pako": "3.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
